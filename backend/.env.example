# Optional: enables OpenRouter-backed summaries and lab-value extraction.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional local override. Keep a stable secret for all backend instances.
JWT_SECRET_KEY=replace-this-with-a-long-random-secret

# Comma-separated frontend origins for direct cross-origin deployments.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
